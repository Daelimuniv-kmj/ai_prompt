{
  "entities": {
    "Prompt": {
      "title": "Prompt",
      "description": "An AI prompt entry stored in the prompt archive.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Display title of the prompt.",
          "minLength": 1,
          "maxLength": 100
        },
        "category": {
          "type": "string",
          "description": "Category of the prompt.",
          "enum": ["사진 합성", "스타일 변환", "캐릭터·포스터"]
        },
        "content": {
          "type": "string",
          "description": "Full prompt text content preserving line breaks and brackets.",
          "minLength": 1,
          "maxLength": 10000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the prompt was created."
        }
      },
      "required": ["title", "category", "content", "createdAt"]
    }
  },
  "firestore": {
    "/prompts/{promptId}": {
      "schema": {
        "$ref": "#/entities/Prompt"
      },
      "description": "Public beginner-friendly AI prompt collection ordered by creation time."
    }
  }
}
